@page "/"
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Zoo Keeper</PageTitle>

<div class="game-container">
    <h1><img class="sprite title-sprite" src="animals/lion.png" alt="" /> Zoo Keeper</h1>
    <div class="stats">
        <span>Score: @score</span>
        <span>Level: @level</span>
        <span>Moves: @moves</span>
        <button class="btn btn-primary" @onclick="NewGame">New Game</button>
    </div>

    <div class="board">
        @for (int r = 0; r < Rows; r++)
        {
            <div class="board-row">
                @for (int c = 0; c < Cols; c++)
                {
                    var row = r;
                    var col = c;
                    var animal = board[r, c];
                    var isSelected = selected.HasValue && selected.Value.r == r && selected.Value.c == c;
                    var isMatching = matching.Contains((r, c));
                    var isHint = hintTiles.Contains((row, col));
                    <div class="tile @(isSelected ? "selected" : "") @(isMatching ? "matching" : "") @(isHint ? "hint" : "")"
                         @onclick="() => OnTileClick(row, col)">
                        @if ((int)animal >= 0)
                        {
                            <img class="sprite" alt="" draggable="false" src="@AnimalSrc(animal)" />
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (message != null)
    {
        <div class="message">@message</div>
    }
</div>

<style>
    .game-container {
        --gap: clamp(2px, 0.8vw, 6px);
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        text-align: center;
        padding: clamp(8px, 2vw, 20px);
        padding-left: max(clamp(8px, 2vw, 20px), env(safe-area-inset-left));
        padding-right: max(clamp(8px, 2vw, 20px), env(safe-area-inset-right));
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(180deg, #87CEEB 0%, #98FB98 100%);
        min-height: 100dvh;
        overflow-x: hidden;
    }
    h1 {
        color: #2c3e50;
        margin-bottom: 10px;
        font-size: clamp(1.5rem, 6vw, 2.5rem);
    }
    .stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px 16px;
        margin-bottom: 12px;
        font-size: clamp(0.95rem, 3.6vw, 1.2rem);
        font-weight: bold;
    }
    .board {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        box-sizing: border-box;
        width: min(100%, 560px);
        margin: 0 auto;
        background: #f4d03f;
        padding: clamp(4px, 1.2vw, 10px);
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.2);
    }
    .board-row {
        display: grid;
        grid-template-columns: repeat(8, minmax(0, 1fr));
        gap: var(--gap);
    }
    .tile {
        box-sizing: border-box;
        width: 100%;
        aspect-ratio: 1;
        min-width: 0;
        margin: 0;
        background: #fff8ea;
        border-radius: clamp(3px, 0.8vw, 6px);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        user-select: none;
        -webkit-user-select: none;
        touch-action: manipulation;
        border: clamp(2px, 0.4vw, 3px) solid transparent;
    }
    @@media (hover: hover) and (pointer: fine) {
        .tile:hover { transform: scale(1.08); }
    }
    .tile.selected { border-color: #e74c3c; box-shadow: 0 0 10px #e74c3c; }
    .tile.matching { animation: pop 0.4s ease; background: #ffeb3b; }
    .tile.hint { animation: hint-pulse 0.7s ease-in-out 3; }
    @@keyframes hint-pulse {
        0%, 100% { background: #fff8ea; box-shadow: none; }
        50% { background: #fff1b8; box-shadow: 0 0 0 2px rgba(255, 196, 60, 0.95); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .tile.hint { animation: none; box-shadow: 0 0 0 2px rgba(255, 196, 60, 0.95); }
    }
    @@keyframes pop {
        0% { transform: scale(1); }
        50% { transform: scale(1.3); }
        100% { transform: scale(1); }
    }
    .sprite {
        width: 82%;
        height: 82%;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
        pointer-events: none;
        -webkit-user-drag: none;
    }
    .title-sprite {
        width: 0.85em;
        height: 0.85em;
        vertical-align: -0.12em;
        margin-right: 0.12em;
    }
    .message { margin-top: 15px; font-size: clamp(1rem, 4vw, 1.3rem); color: #27ae60; font-weight: bold; }
</style>

@code {
    const int Rows = 8;
    const int Cols = 8;
    enum Animal { Lion, Giraffe, Panda, Elephant, Hippo, Crocodile, Monkey }

    const int HintDelayMs = 4000;
    const int HintFlashMs = 2100;

    Animal[,] board = new Animal[Rows, Cols];
    (int r, int c)? selected = null;
    HashSet<(int r, int c)> matching = new();
    HashSet<(int r, int c)> hintTiles = new();
    int score = 0;
    int level = 1;
    int moves = 0;
    string? message;
    Random rnd = new();
    int hintVersion;
    int gameId;
    bool resolving;
    bool disposed;
    CancellationTokenSource lifetime = new();

    protected override void OnInitialized()
    {
        NewGame();
    }

    void NewGame()
    {
        gameId++;
        score = 0;
        level = 1;
        moves = 0;
        selected = null;
        matching.Clear();
        resolving = false;
        message = "Match 3 or more animals!";
        GenerateBoard();
        ResetHintTimer();
        StateHasChanged();
    }

    public void Dispose()
    {
        disposed = true;
        hintVersion++;
        lifetime.Cancel();
        lifetime.Dispose();
    }

    void GenerateBoard()
    {
        for (int r = 0; r < Rows; r++)
            for (int c = 0; c < Cols; c++)
                board[r, c] = (Animal)rnd.Next(7);

        // Remove initial matches
        int safety = 0;
        while (FindMatches().Count > 0 && safety++ < 100)
        {
            foreach (var (r, c) in FindMatches())
                board[r, c] = (Animal)rnd.Next(7);
        }
    }

    static string AnimalSrc(Animal animal) => $"animals/{animal.ToString().ToLowerInvariant()}.png";

    async Task OnTileClick(int r, int c)
    {
        if (resolving) return;

        ResetHintTimer();

        if (selected == null)
        {
            selected = (r, c);
            return;
        }

        var (sr, sc) = selected.Value;
        if (IsAdjacent(sr, sc, r, c))
        {
            // Swap
            (board[sr, sc], board[r, c]) = (board[r, c], board[sr, sc]);
            moves++;

            var matches = FindMatches();
            if (matches.Count == 0)
            {
                // Invalid swap, reverse
                (board[sr, sc], board[r, c]) = (board[r, c], board[sr, sc]);
                moves--;
                message = "No match! Try again.";
            }
            else
            {
                var id = gameId;
                resolving = true;
                try
                {
                    await ProcessMatches(id);
                }
                finally
                {
                    if (id == gameId)
                    {
                        resolving = false;
                        ResetHintTimer();
                    }
                }
            }
        }

        selected = null;
        StateHasChanged();
    }

    void ResetHintTimer()
    {
        hintTiles.Clear();
        var version = ++hintVersion;
        _ = RunHintAsync(version);
    }

    async Task RunHintAsync(int version)
    {
        try
        {
            await Task.Delay(HintDelayMs, lifetime.Token);
            if (version != hintVersion || disposed || resolving) return;

            var move = FindHint();
            if (move == null)
            {
                if (version == hintVersion && !disposed)
                    ResetHintTimer();
                return;
            }

            hintTiles = new HashSet<(int r, int c)>(move);
            await RefreshAsync();
            await Task.Delay(HintFlashMs, lifetime.Token);
            if (version != hintVersion || disposed) return;

            hintTiles.Clear();
            await RefreshAsync();
            ResetHintTimer();
        }
        catch (OperationCanceledException)
        {
        }
    }

    async Task RefreshAsync()
    {
        if (!disposed)
            await InvokeAsync(StateHasChanged);
    }

    List<(int r, int c)>? FindHint()
    {
        for (int r = 0; r < Rows; r++)
        {
            for (int c = 0; c < Cols; c++)
            {
                if (c + 1 < Cols && SwapMakesMatch(r, c, r, c + 1))
                    return new() { (r, c), (r, c + 1) };
                if (r + 1 < Rows && SwapMakesMatch(r, c, r + 1, c))
                    return new() { (r, c), (r + 1, c) };
            }
        }

        return null;
    }

    bool SwapMakesMatch(int r1, int c1, int r2, int c2)
    {
        (board[r1, c1], board[r2, c2]) = (board[r2, c2], board[r1, c1]);
        bool match = FindMatches().Count > 0;
        (board[r1, c1], board[r2, c2]) = (board[r2, c2], board[r1, c1]);
        return match;
    }

    bool IsAdjacent(int r1, int c1, int r2, int c2)
    {
        return (Math.Abs(r1 - r2) == 1 && c1 == c2) || (Math.Abs(c1 - c2) == 1 && r1 == r2);
    }

    HashSet<(int r, int c)> FindMatches()
    {
        var set = new HashSet<(int, int)>();

        // Horizontal
        for (int r = 0; r < Rows; r++)
        {
            int count = 1;
            for (int c = 1; c < Cols; c++)
            {
                if (board[r, c] == board[r, c - 1] && (int)board[r, c] >= 0)
                    count++;
                else
                {
                    if (count >= 3)
                        for (int k = 0; k < count; k++) set.Add((r, c - 1 - k));
                    count = 1;
                }
            }
            if (count >= 3)
                for (int k = 0; k < count; k++) set.Add((r, Cols - 1 - k));
        }

        // Vertical
        for (int c = 0; c < Cols; c++)
        {
            int count = 1;
            for (int r = 1; r < Rows; r++)
            {
                if (board[r, c] == board[r - 1, c] && (int)board[r, c] >= 0)
                    count++;
                else
                {
                    if (count >= 3)
                        for (int k = 0; k < count; k++) set.Add((r - 1 - k, c));
                    count = 1;
                }
            }
            if (count >= 3)
                for (int k = 0; k < count; k++) set.Add((Rows - 1 - k, c));
        }

        return set;
    }

    async Task ProcessMatches(int id)
    {
        while (id == gameId)
        {
            var matches = FindMatches();
            if (matches.Count == 0) break;

            matching = matches;
            int points = matches.Count * 10 * level;
            score += points;
            message = $"+{points} points!";
            StateHasChanged();
            await Task.Delay(400);
            if (id != gameId) return;

            // Clear
            foreach (var (r, c) in matches)
                board[r, c] = (Animal)(-1);

            // Gravity + fill
            for (int c = 0; c < Cols; c++)
            {
                int write = Rows - 1;
                for (int r = Rows - 1; r >= 0; r--)
                {
                    if ((int)board[r, c] != -1)
                    {
                        board[write, c] = board[r, c];
                        if (write != r) board[r, c] = (Animal)(-1);
                        write--;
                    }
                }
                for (int r = write; r >= 0; r--)
                    board[r, c] = (Animal)rnd.Next(7);
            }

            matching.Clear();
            StateHasChanged();
            await Task.Delay(200);
            if (id != gameId) return;
        }

        int newLevel = (score / 500) + 1;
        if (newLevel > level)
        {
            level = newLevel;
            message = $"Level {level}!";
        }
        else
        {
            message = null;
        }
    }
}
